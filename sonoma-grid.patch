+
+// The original sheet hangs in SwiftUI/UICollectionView layout on macOS 14.
+// Use finite, non-lazy rows and explicit actions there, leaving macOS 15+ intact.
+enum SettingsSheetCompatibility {
+    static var needsPlainLayout: Bool {
+        #if targetEnvironment(macCatalyst)
+        if #available(macCatalyst 18.0, *) { return false }
+        return true
+        #else
+        return false
+        #endif
+    }
+}
+
+struct SettingsPlainPage<Content: View>: View {
+    let title: String
+    let confirmTitle: String
+    var confirmEnabled = true
+    let confirm: () -> Void
+    let cancel: () -> Void
+    @ViewBuilder var content: () -> Content
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Button(L("Cancel"), action: cancel)
+                Spacer()
+                Text(title).font(.headline)
+                Spacer()
+                Button(confirmTitle, action: confirm).disabled(!confirmEnabled)
+            }.padding(20)
+            Divider()
+            ScrollView {
+                VStack(alignment: .leading, spacing: 12, content: content)
+                    .frame(maxWidth: .infinity, alignment: .leading).padding(20)
+            }
+        }
+        .foregroundStyle(Theme.text).background(Theme.sheet)
+        .macPageActions(confirmTitle: confirmTitle, confirmEnabled: confirmEnabled,
+                        confirm: confirm, cancel: cancel)
+    }
+}
+
+private struct SettingsPlainCheck: View {
+    let title: String
+    let summary: String
+    let on: Bool
+    var mixed = false
+    let action: () -> Void
+    var body: some View {
+        Button(action: action) {
+            HStack(alignment: .center, spacing: 12) {
+                Image(systemName: mixed ? "minus.square.fill" : (on ? "checkmark.square.fill" : "square"))
+                    .foregroundStyle(on || mixed ? Theme.accent : Theme.secondaryText)
+                VStack(alignment: .leading, spacing: 3) {
+                    Text(title)
+                    if !summary.isEmpty { Text(summary).font(.caption).foregroundStyle(Theme.secondaryText).lineLimit(2) }
+                }
+                Spacer(minLength: 0)
+            }.frame(maxWidth: .infinity, minHeight: 44, alignment: .leading).contentShape(Rectangle())
+        }.buttonStyle(.plain)
+            .accessibilityLabel(title).accessibilityValue(mixed ? "−" : (on ? "✓" : ""))
+            .accessibilityAddTraits(on ? [.isSelected] : [])
     }
 }
